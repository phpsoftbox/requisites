{
    "name": "phpsoftbox/requisites",
    "description": "Requisites component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/collection": "^1.0",
        "phpsoftbox/data-casting": "^1.0",
        "phpsoftbox/database": "^1.0",
        "phpsoftbox/filter": "^1.0",
        "phpsoftbox/forms": "^1.0",
        "phpsoftbox/orm": "^1.0",
        "phpsoftbox/validator": "^1.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "phpsoftbox/cli-app": "Required for the requisites:migrate command (RequisitesCommandProvider)."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Requisites\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Requisites\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Requisites\\Cli\\RequisitesCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
